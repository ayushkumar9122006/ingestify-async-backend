# Ingestify Environment Variables Configuration Template

# Server settings
PROJECT_NAME="Ingestify"
VERSION="1.0.0"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ingestify

# Message Broker & Backend (Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security / JWT
SECRET_KEY=ingestify-production-super-secret-key-change-me-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_BASE_DIR=/app/storage
UPLOAD_DIR=/app/storage/uploads
ARTIFACT_DIR=/app/storage/artifacts
THUMBNAIL_DIR=/app/storage/thumbnails
